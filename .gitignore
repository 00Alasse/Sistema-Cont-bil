# --- Dependências (reinstaladas com `composer install`) ---
/vendor/
composer.phar

# --- Configuração local e segredos ---
.env
.env.*
!.env.example
!.env.production.example

# --- Arquivos gerados em tempo de execução ---
/storage/logs/*
!/storage/logs/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
*.log

# --- Testes e análise ---
/coverage/
.phpunit.cache/
.phpunit.result.cache

# --- Pacote de publicação gerado localmente ---
/build/

# --- Editores e sistema operacional ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.tmp
*~
.DS_Store
Thumbs.db
desktop.ini
