# =============================================================
# Tributo: configuração do ambiente LOCAL (XAMPP)
# Copie este arquivo para `.env` e ajuste. Nunca versione o `.env`.
# =============================================================

# --- Aplicação ---
APP_NAME="Tributo"
# local | testing | production
APP_ENV=local
# true mostra detalhes de erro na tela (NUNCA em produção)
APP_DEBUG=true
# URL pública completa, sem barra no final
APP_URL=http://localhost/tributo
# Subpasta onde o sistema é servido. Ex.: /tributo no XAMPP (htdocs/tributo).
# Deixe vazio quando o sistema estiver na raiz do domínio.
APP_BASE_PATH=/tributo
APP_TIMEZONE=America/Sao_Paulo

# --- Banco de dados (MariaDB do XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tributo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Banco usado pelos testes de integração (é apagado e recriado)
DB_TEST_DATABASE=tributo_test

# --- Sessão ---
SESSION_NAME=tributo_sessao
SESSION_IDLE_MINUTES=30
# true somente quando o site estiver em HTTPS
SESSION_SECURE_COOKIE=false

# --- Login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Uploads ---
# Limite por arquivo, em bytes (10 MB). Confira também upload_max_filesize e post_max_size no php.ini.
UPLOAD_MAX_BYTES=10485760
UPLOAD_PATH=storage/uploads

# --- Logs ---
# debug | info | warning | error
LOG_LEVEL=debug
LOG_PATH=storage/logs
