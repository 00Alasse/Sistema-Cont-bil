# Análise estática: configuração inicial simples.
# O nível será elevado gradualmente (ver docs/DECISIONS.md, ADR-019).
parameters:
  level: 5
  paths:
    - app
    - bin
    - config
    - public
    - tests
  scanFiles:
    - tests/Support/PHPStan/UsuarioLogado.stub
  tmpDir: storage/cache/phpstan
