# =============================================================
# Tributo: modelo de configuração de PRODUÇÃO (hospedagem)
# No servidor, copie para `.env` e preencha com os dados do painel
# da hospedagem. Nunca versione o `.env` real.
# =============================================================

APP_NAME="Tributo"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio.exemplo
APP_BASE_PATH=
APP_TIMEZONE=America/Sao_Paulo

# Dados fornecidos pelo painel da hospedagem
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TEST_DATABASE=

SESSION_NAME=tributo_sessao
SESSION_IDLE_MINUTES=30
# Hospedagem com HTTPS: mantenha true
SESSION_SECURE_COOKIE=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

UPLOAD_MAX_BYTES=10485760
UPLOAD_PATH=storage/uploads

LOG_LEVEL=warning
LOG_PATH=storage/logs
