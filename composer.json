{
    "name": "tributo/tributo",
    "description": "Plataforma web para escritórios de contabilidade e seus clientes: obrigações, documentos, BPO financeiro e gestão consultiva.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:e2e": "phpunit --testsuite E2E",
        "lint": "@php bin/lint.php",
        "analyse": "phpstan analyse --memory-limit=512M --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Executa todas as suítes do PHPUnit.",
        "lint": "Verifica a sintaxe de todos os arquivos PHP (php -l).",
        "analyse": "Executa a análise estática (PHPStan).",
        "check": "Executa lint, análise estática e testes, nesta ordem."
    }
}
